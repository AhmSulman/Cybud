<Window x:Class="Cybud_WPF_0._1.Views.Schedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybud_WPF_0._1.Views"
        mc:Ignorable="d"
        Title="Schedule" Height="1622" Width="1981">
    <Grid Margin="20">
        <!-- Title -->
        <TextBlock Text="Schedule Manager" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,20"/>

        <!-- Time Table Layout -->
        <Grid>
            <!-- Define Columns for Time and Activity -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Time Labels -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Height="1428">
                <TextBlock Text="08:00 AM" FontWeight="Bold" Margin="0,10"/>
                <TextBlock Text="09:00 AM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="10:00 AM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="11:00 AM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="12:00 PM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="01:00 PM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="02:00 PM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="03:00 PM" FontWeight="Bold" Margin="0,40"/>
                <TextBlock Text="04:00 PM" FontWeight="Bold" Margin="0,40"/>
            </StackPanel>

            <!-- Activity Input Fields -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBox Text="{Binding TimeSlot0800AM, UpdateSourceTrigger=PropertyChanged}" Margin="0,10"/>
                <TextBox Text="{Binding TimeSlot0900AM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot1000AM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot1100AM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot1200PM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot0100PM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot0200PM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot0300PM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
                <TextBox Text="{Binding TimeSlot0400PM, UpdateSourceTrigger=PropertyChanged}" Margin="0,40"/>
            </StackPanel>
        </Grid>

        <!-- Save Schedule Button -->
        <Button Command="{Binding SaveScheduleCommand}" Content="Save Schedule" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="200" Height="40"/>
    </Grid>
</Window>
