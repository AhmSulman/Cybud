<Window x:Class="Cybud_WPF_0._1.Views.Chat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybud_WPF_0._1.ViewModels" 
    mc:Ignorable="d"
        Title="Chat" Height="450" Width="800">

    <Window.DataContext>
        <local:ChatAiServiceViewModel />
        <!-- Set DataContext here -->
    </Window.DataContext>

    <Grid Margin="0,0,0,-6">
        <!-- Chat Output TextBox: This will display the chat conversation -->
        <TextBox Text="{Binding ChatOutput, Mode=OneWay}" 
                 VerticalScrollBarVisibility="Auto" 
                 IsReadOnly="True"
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 Margin="10,10,10,60"  
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top" 
                 TextChanged="Ai_Response" />

        <!-- User Input TextBox -->
        <TextBox Text="{Binding UserInput}" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Bottom" 
                 Width="685"
                 Height="40"
                 Margin="0,0,0,10" />

        <!-- Send Button -->
        <Button Content="Send" 
                Command="{Binding SendMessageCommand}"
            HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Width="100"
                Height="40"
                Margin="10" 
                Click="Send_Click" />
    </Grid>
    
    </Window>
