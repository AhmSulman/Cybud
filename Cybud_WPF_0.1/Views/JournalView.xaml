<Window x:Class="Cybud_WPF_0._1.Views.JournalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybud_WPF_0._1.ViewModels"
        mc:Ignorable="d"
        Title="JournalView" Height="487" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input for new journal entry -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Width="300" Text="{Binding NewEntryTitle, Mode=TwoWay}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Entry:" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <TextBox Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 Text="{Binding NewEntryContent, Mode=TwoWay}" Height="100"/>

        <Button Grid.Row="1" Content="Save" Width="83" HorizontalAlignment="Left"
                Command="{Binding SaveJournalCommand}" Margin="697,367,0,0" Grid.RowSpan="2" Click="Save_Click" />

        <!-- List of Journal Entries -->
        <ListView Grid.Row="2" Margin="0,5,416,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}"/>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Content" DisplayMemberBinding="{Binding Content}"/>
                </GridView>
            </ListView.View>
            <ScrollBar/>
        </ListView>

    </Grid>
</Window>
