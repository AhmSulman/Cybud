<Window x:Class="Cybud_WPF_0._1.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybud_WPF_0._1"
        mc:Ignorable="d"
        Title="Register" Height="450" Width="800">
    <Grid>
        <Label Content="Email" HorizontalAlignment="Left" Margin="174,160,0,0" VerticalAlignment="Top"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="174,0,0,0" VerticalAlignment="Center"
               x:Name="Password_register"/>
        <TextBox HorizontalAlignment="Left" Margin="311,160,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"
                 x:Name="Email_Register"/>
        <PasswordBox HorizontalAlignment="Left" Margin="311,212,0,0" VerticalAlignment="Top" Width="120"
          x:Name="Password_Register"/>
        <Button Content="Register" HorizontalAlignment="Left" Margin="311,277,0,0" VerticalAlignment="Top" Click="Register_Click"/>
        <Button Content="Sign In" HorizontalAlignment="Left" Margin="400,277,0,0" VerticalAlignment="Top" Click="SignIn_Register_Click"/>

    </Grid>
</Window>
