<Window x:Class="Cybud_WPF_0._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybud_WPF_0._1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox HorizontalAlignment="Center" Margin="0,158,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"
                 x:Name="Email_SignIn"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="238,149,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.569,-0.054"/>
        <Button Content="Sign In" HorizontalAlignment="Left" Margin="316,259,0,0" VerticalAlignment="Top" Click="SignIN_Click"/>
        <Button Content="Register" HorizontalAlignment="Left" Margin="420,259,0,0" VerticalAlignment="Top"
                Click="Register_Click"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="238,191,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.915,0.214"/>
        <PasswordBox HorizontalAlignment="Center" Margin="0,204,0,0" VerticalAlignment="Top" Width="120"
                     x:Name="Password_SignIn"/>

    </Grid>
</Window>
